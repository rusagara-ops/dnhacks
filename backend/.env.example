# Get the direct or session-pooler URI from Supabase > Connect.
# URL-encode special characters in the password. Never commit backend/.env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# Set a shared demo token before exposing the coordinator beyond localhost.
API_TOKEN=replace-with-a-random-demo-token
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HEARTBEAT_INTERVAL_SECONDS=5
WORKER_TIMEOUT_SECONDS=15

# Uncomment together after Kevin confirms the exact model and pinned revision.
# INFERENCE_MODEL_ID=agreed-model-id
# INFERENCE_MODEL_REVISION=pinned-revision
TASK_LEASE_SECONDS=300
TASK_MAX_RUNTIME_SECONDS=1800
RECOVERY_INTERVAL_SECONDS=5
